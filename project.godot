; Protótipo GT3 Time Attack em Godot 4 — Interlagos + Porsche 992 GT3 R.
config_version=5

[application]

config/name="GT3 Godot (protótipo)"
run/main_scene="res://scenes/garagem.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=500
common/max_physics_steps_per_frame=24

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_taa=false
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/16_bits=false
textures/vram_compression/import_etc2_astc=true

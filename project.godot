; Protótipo GT3 Time Attack em Godot 4 — Interlagos + Porsche 992 GT3 R.
config_version=5

[application]

config/name="GT3 Time Attack"
run/main_scene="res://scenes/updater.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/vsync/vsync_mode=1
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
common/physics_ticks_per_second.mobile=60
common/max_physics_steps_per_frame=4
common/max_physics_steps_per_frame.mobile=2

[rendering]

environment/defaults/default_clear_color=Color(0.043, 0.051, 0.063, 1)
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.mobile=0
anti_aliasing/quality/use_taa=false
textures/default_filters/anisotropic_filtering_level=4
textures/default_filters/anisotropic_filtering_level.mobile=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/directional_shadow/16_bits=true
lights_and_shadows/directional_shadow/16_bits.mobile=true
textures/vram_compression/import_etc2_astc=true

[importer_defaults]

texture={
"compress/mode": 2,
"mipmaps/generate": true,
"process/size_limit": 1024
}
